	partition CommunityMapLocations = m
		mode: import
		source =
				let
				  Source = permits_clean,
				  #"Merged queries 1" = Table.NestedJoin(Source, {"communitycode"}, CommunityCentroids, {"comm_code"}, "CommunityCentroids", JoinKind.LeftOuter),
				  #"Expanded CommunityCentroids" = Table.ExpandTableColumn(#"Merged queries 1", "CommunityCentroids", {"Longitude", "Latitude"}, {"Longitude.1", "Latitude.1"}),
				  #"Renamed columns" = Table.RenameColumns(#"Expanded CommunityCentroids", {{"Longitude.1", "OfficialLongitude"}, {"Latitude.1", "OfficialLatitude"}}),
				  #"Sorted rows" = Table.Sort(#"Renamed columns", {{"ward", Order.Ascending}}),
				  #"Merged queries" = Table.NestedJoin(#"Sorted rows", {"communitycode"}, FallbackCommunityCoordinates, {"communitycode"}, "FallbackCommunityCoordinates", JoinKind.LeftOuter),
				  #"Expanded FallbackCommunityCoordinates" = Table.ExpandTableColumn(#"Merged queries", "FallbackCommunityCoordinates", {"FallbackLatitude", "FallbackLongitude"}, {"FallbackLatitude", "FallbackLongitude"}),
				  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Expanded FallbackCommunityCoordinates", "MapLatitude", each if [OfficialLatitude] <> null
				    and [OfficialLongitude] <> null
				then [OfficialLatitude]
				else [FallbackLatitude]), {{"MapLatitude", type number}}),
				  #"Added custom 1" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom", "MapLongitude", each if [OfficialLatitude] <> null
				    and [OfficialLongitude] <> null
				then [OfficialLongitude]
				else [FallbackLongitude]), {{"MapLongitude", type number}}),
				  #"Added custom 2" = Table.AddColumn(#"Added custom 1", "MapLocationSource", each if [OfficialLatitude] <> null
				    and [OfficialLongitude] <> null
				then "Official Centroid"
				else if [FallbackLatitude] <> null
				    and [FallbackLongitude] <> null
				then "Estimated"
				else "Missing Coordinates")
				in
				  #"Added custom 2"

	annotation PBI_ResultType = Table

