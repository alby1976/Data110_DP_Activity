table 00_Measures
	lineageTag: c94e1afd-12e5-4449-84c8-9f0f4f12eae1

	measure 'Median Processing Days' =
			
			MEDIANX(
			    FILTER(
			        permits_clean,
			        NOT ISBLANK(permits_clean[ProcessingDays])
			            && permits_clean[ProcessingDays] >= 0
			    ),
			    permits_clean[ProcessingDays]
			)
		formatString: 0
		lineageTag: 39aeb927-45c5-422f-91d2-7ce3d6433ae1

	measure 'Monthly Average Permits' =
			
			AVERAGEX(
			    VALUES(permits_clean[YearMonth]),
			    [Residential Permits]
			)
		formatString: 0
		lineageTag: 1cc10215-986e-4a80-ad57-1b6b338bc4ed

	measure 'Residential Permits' =
			
			DISTINCTCOUNT(permits_clean[permit_number])
		formatString: 0
		lineageTag: a0bb604a-7beb-42e8-b659-c0b1082d0119

	measure 'Rezoning-Relevant Permits' =
			
			CALCULATE(
			    [Residential Permits],
			    permits_clean[RezoningRelevant] = True
			)
		formatString: 0
		lineageTag: edd1fe9b-ef49-43de-96bc-6a5fc392b09f

	measure 'Rezoning-Relevant Share' =
			
			DIVIDE(
			    [Rezoning-Relevant Permits],
			    [Residential Permits],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 42a4eee2-610d-4260-97a2-37bf0b1da42c

	measure 'Dataset Latest Date' =
			
			MAXX(
			    ALL(permits_clean),
			    permits_clean[applied_date]
			)
		formatString: General Date
		lineageTag: 1a00101a-0e00-43d3-b3e2-93e0fe42b956

	measure 'Data Completeness' =
			
			VAR LatestDate =
			    [Dataset Latest Date]
			
			VAR MonthComplete =
			    LatestDate = EOMONTH(LatestDate, 0)
			
			RETURN
			    IF(
			        MonthComplete,
			        "✓ Data complete through "
			            & FORMAT(LatestDate, "MMM yyyy"),
			        "⚠ Data through "
			            & FORMAT(LatestDate, "MMM d, yyyy")
			            & " — partial month"
			    )
		lineageTag: bf18668c-f52c-45f3-97bb-eab9c6b180c9

	measure 'Permit Count' =
			
			COUNTROWS(permits_clean)
		formatString: 0
		lineageTag: d2f5c706-acd5-4d61-8987-a16e0f3ac445

	measure 'Median Processing Days Dynamic' =
			
			CALCULATE(
			    MEDIAN(permits_clean[ProcessingDays]),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		lineageTag: d95c4dcb-7ce2-471a-b96a-dddf08ecfb04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valid Count Dynamic' =
			
			CALCULATE(
			    COUNTROWS(permits_clean),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		formatString: 0
		lineageTag: dd0ccf09-369e-4251-9b92-877bbf747813

	measure 'Q1 Processing Days Dynamic' =
			
			CALCULATE(
			    PERCENTILEX.INC(
			        permits_clean,
			        permits_clean[ProcessingDays],
			        0.25
			    ),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		lineageTag: b8df6d2e-bf78-4ce1-838d-3301b312668b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Q3 Processing Days Dynamic' =
			
			CALCULATE(
			    PERCENTILEX.INC(
			        permits_clean,
			        permits_clean[ProcessingDays],
			        0.75
			    ),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		lineageTag: 8d1eb945-1f35-4223-af47-9d8ccb6d8740

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IQR Processing Days Dynamic' =
			
			VAR Q1 = [Q1 Processing Days Dynamic]
			VAR Q3 = [Q3 Processing Days Dynamic]
			RETURN
			    IF(
			        ISBLANK(Q1) || ISBLANK(Q3),
			        BLANK(),
			        Q3 - Q1
			    )
		lineageTag: 99a8ae7a-21bb-4cba-8605-e2acae144d60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valid Share Dynamic' =
			
			DIVIDE(
			    [Valid Count Dynamic],
			    [Permit Count]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 874b4122-1fcc-4b79-ab40-656c5aaab524

	measure 'Non-Valid Share Dynamic' =
			
			IF(
			    ISBLANK([Valid Share Dynamic]),
			    BLANK(),
			    1 - [Valid Share Dynamic]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e13a948b-5d9d-4629-832e-7df8cac22a3c

	measure 'Geo Before Permits' =
			
			CALCULATE(
			    [Permit Count],
			    REMOVEFILTERS(permits_clean[Period]),
			    permits_clean[Period] = "Before"
			)
		formatString: 0
		lineageTag: 24a7fb03-013d-4cee-8b3c-42add49b5225

	measure 'Geo During Permits' =
			
			CALCULATE(
			    [Permit Count],
			    REMOVEFILTERS(permits_clean[Period]),
			    permits_clean[Period] = "During"
			)
		formatString: 0
		lineageTag: b337f315-2274-475d-9db3-49dbb17ec1c4

	measure 'Geo Absolute Change' =
			
			[Geo During Permits] - [Geo Before Permits]
		formatString: 0
		lineageTag: 87ed43e4-b318-4b36-aac7-a3081f6f5ee1

	measure 'Geo Percentage Change' =
			
			DIVIDE(
			    [Geo Absolute Change],
			    [Geo Before Permits]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 70e7bbd4-6b97-403c-9b1c-05874f7ebcdd

	measure 'Geo Baseline Warning' =
			
			SWITCH(
			    TRUE(),
			    [Geo Before Permits] = 0,
			        "No baseline",
			    [Geo Before Permits] < 30,
			        "Low baseline",
			    "OK"
			)
		lineageTag: 0f884711-df2f-4562-8116-0249677b4c01

	measure 'Geo Rankable Percentage Change' =
			
			IF(
			    [Geo Before Permits] >= 30,
			    [Geo Percentage Change],
			    BLANK()
			)
		lineageTag: 8f093ed9-5a2e-4dfa-a4c9-faa7490d6156

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Geo Before Exposure Days' =
			
			CALCULATE(
			    COUNTROWS('Calendar'),
			    REMOVEFILTERS(Calendar[Policy Period]),
			    Calendar[Policy Period] = "Before"
			)
		formatString: 0
		lineageTag: 3cf764dc-5eca-4611-82e9-e674c1c7dec9

	measure 'Geo During Exposure Days' =
			
			CALCULATE(
			    COUNTROWS('Calendar'),
			    REMOVEFILTERS(Calendar[Policy Period]),
			    Calendar[Policy Period] = "During"
			)
		formatString: 0
		lineageTag: 23f82d49-ed3e-4045-9ccd-2deee6cf3d10

	measure 'Geo Before Rate 30' =
			
			DIVIDE(
			    [Geo Before Permits] * 30,
			    [Geo Before Exposure Days]
			)
		lineageTag: 6937394e-d710-4b2d-bded-ffda81d901b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Geo During Rate 30' =
			
			DIVIDE(
			    [Geo During Permits] * 30,
			    [Geo During Exposure Days]
			)
		lineageTag: 0828caa3-3e02-4d21-bde2-84f040c7a870

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Geo Rate 30 Change' =
			
			[Geo During Rate 30] - [Geo Before Rate 30]
		lineageTag: 50759843-99df-416b-9392-451d0eb4e414

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Geo Rate 30 Change %' =
			
			DIVIDE(
			    [Geo Rate 30 Change],
			    [Geo Before Rate 30]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 984c701c-3931-4635-933f-e208ff8bf044

	measure 'Geo Rankable Rate 30 Change %' =
			
			IF(
			    [Geo Before Permits] >= 30,
			    [Geo Rate 30 Change %],
			    BLANK()
			)
		lineageTag: a293d0ee-3a15-4971-b673-412493f3e128

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Geo Selected Change' =
			
			SWITCH(
			    SELECTEDVALUE(
			        'Geography Metric'[Metric],
			        "Applications per 30 Days"
			    ),
			
			    "Raw Applications",
			        [Geo Absolute Change],
			
			    "Applications per 30 Days",
			        [Geo Rate 30 Change]
			)
		lineageTag: ed744f43-40af-47ee-9904-a817e90f2f03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7583c16b-0653-48ae-8458-a945cc9a9741
		summarizeBy: sum
		sourceColumn: Placeholder

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 00_Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Placeholder = _t]),
				  #"Changed column type" = Table.TransformColumnTypes(Source, {{"Placeholder", Int64.Type}}, "en-US")
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

