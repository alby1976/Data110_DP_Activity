table 00_Measures
	lineageTag: c94e1afd-12e5-4449-84c8-9f0f4f12eae1

	measure 'Median Processing Days' =
			
			MEDIANX(
			    FILTER(
			        permits_clean,
			        NOT ISBLANK(permits_clean[ProcessingDays])
			            && permits_clean[ProcessingDays] >= 0
			    ),
			    permits_clean[ProcessingDays]
			)
		formatString: 0
		lineageTag: 39aeb927-45c5-422f-91d2-7ce3d6433ae1

	measure 'Monthly Average Permits' =
			
			AVERAGEX(
			    VALUES(permits_clean[YearMonth]),
			    [Residential Permits]
			)
		formatString: 0
		lineageTag: 1cc10215-986e-4a80-ad57-1b6b338bc4ed

	measure 'Residential Permits' =
			
			DISTINCTCOUNT(permits_clean[permit_number])
		formatString: 0
		lineageTag: a0bb604a-7beb-42e8-b659-c0b1082d0119

	measure 'Rezoning-Relevant Permits' =
			
			CALCULATE(
			    [Residential Permits],
			    permits_clean[RezoningRelevant] = True
			)
		formatString: 0
		lineageTag: edd1fe9b-ef49-43de-96bc-6a5fc392b09f

	measure 'Rezoning-Relevant Share' =
			
			DIVIDE(
			    [Rezoning-Relevant Permits],
			    [Residential Permits],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 42a4eee2-610d-4260-97a2-37bf0b1da42c

	measure 'Dataset Latest Date' =
			
			MAXX(
			    ALL(permits_clean),
			    permits_clean[applied_date]
			)
		formatString: General Date
		lineageTag: 1a00101a-0e00-43d3-b3e2-93e0fe42b956

	measure 'Data Completeness' =
			
			VAR LatestDate =
			    [Dataset Latest Date]
			
			VAR MonthComplete =
			    LatestDate = EOMONTH(LatestDate, 0)
			
			RETURN
			    IF(
			        MonthComplete,
			        "✓ Data complete through "
			            & FORMAT(LatestDate, "MMM yyyy"),
			        "⚠ Data through "
			            & FORMAT(LatestDate, "MMM d, yyyy")
			            & " — partial month"
			    )
		lineageTag: bf18668c-f52c-45f3-97bb-eab9c6b180c9

	measure 'Permit Count' =
			
			COUNTROWS(permits_clean)
		formatString: 0
		lineageTag: d2f5c706-acd5-4d61-8987-a16e0f3ac445

	measure 'Median Processing Days Dynamic' =
			
			CALCULATE(
			    MEDIAN(permits_clean[ProcessingDays]),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		lineageTag: d95c4dcb-7ce2-471a-b96a-dddf08ecfb04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valid Count Dynamic' =
			
			CALCULATE(
			    COUNTROWS(permits_clean),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		formatString: 0
		lineageTag: dd0ccf09-369e-4251-9b92-877bbf747813

	measure 'Q1 Processing Days Dynamic' =
			
			CALCULATE(
			    PERCENTILEX.INC(
			        permits_clean,
			        permits_clean[ProcessingDays],
			        0.25
			    ),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		lineageTag: b8df6d2e-bf78-4ce1-838d-3301b312668b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Q3 Processing Days Dynamic' =
			
			CALCULATE(
			    PERCENTILEX.INC(
			        permits_clean,
			        permits_clean[ProcessingDays],
			        0.75
			    ),
			    permits_clean[HasValidProcessingDays] = TRUE()
			)
		lineageTag: 8d1eb945-1f35-4223-af47-9d8ccb6d8740

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IQR Processing Days Dynamic' =
			
			VAR Q1 = [Q1 Processing Days Dynamic]
			VAR Q3 = [Q3 Processing Days Dynamic]
			RETURN
			    IF(
			        ISBLANK(Q1) || ISBLANK(Q3),
			        BLANK(),
			        Q3 - Q1
			    )
		lineageTag: 99a8ae7a-21bb-4cba-8605-e2acae144d60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valid Share Dynamic' =
			
			DIVIDE(
			    [Valid Count Dynamic],
			    [Permit Count]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 874b4122-1fcc-4b79-ab40-656c5aaab524

	measure 'Non-Valid Share Dynamic' =
			
			IF(
			    ISBLANK([Valid Share Dynamic]),
			    BLANK(),
			    1 - [Valid Share Dynamic]
			)
		lineageTag: e13a948b-5d9d-4629-832e-7df8cac22a3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7583c16b-0653-48ae-8458-a945cc9a9741
		summarizeBy: sum
		sourceColumn: Placeholder

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 00_Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Placeholder = _t]),
				  #"Changed column type" = Table.TransformColumnTypes(Source, {{"Placeholder", Int64.Type}}, "en-US")
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

