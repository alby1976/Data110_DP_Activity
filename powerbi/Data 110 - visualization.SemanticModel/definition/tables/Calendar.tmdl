table Calendar
	lineageTag: e27c3e1f-c3f1-4e32-9046-8e025dad42e7

	column Date
		formatString: Long Date
		lineageTag: 87966907-f0ce-40c7-9884-59ab136b8a50
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: 9822e074-e5f3-43d9-965c-70e6e0bd76b2
			defaultHierarchy: LocalDateTable_befb86d6-a42b-432c-8890-3c71dbb1a0a7.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		formatString: 0
		lineageTag: 547bccd3-e6d3-4735-b1e5-cae3a3d805a6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = User

	column 'Month Number'
		formatString: 0
		lineageTag: 2e90009b-2cb2-4f11-a072-d33c4e277575
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column Season
		lineageTag: 3979f57f-c423-451b-ac1e-37c33cfc941c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Season]

		annotation SummarizationSetBy = Automatic

	column 'Policy Period'
		lineageTag: df611d6b-ed48-45f7-99fd-a42707345b99
		summarizeBy: none
		isNameInferred
		sourceColumn: [Policy Period]

		annotation SummarizationSetBy = Automatic

	column YearMonth
		lineageTag: 57face93-4f34-446e-9005-ed1c83ee0737
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth]

		annotation SummarizationSetBy = Automatic

	column 'Month Start'
		formatString: Long Date
		lineageTag: ff31b653-bb0f-4707-9823-720d051d75d9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

		variation Variation
			isDefault
			relationship: 14b947f7-c016-463f-b90b-c5216b23bf36
			defaultHierarchy: LocalDateTable_873f1889-8346-41df-8c0f-71c39ec7f191.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Calendar = calculated
		mode: import
		source =
				
				VAR StartDate =
				    MINX(
				        ALL(permits_clean),
				        permits_clean[applied_date]
				    )
				VAR EndDate =
				    MAXX(
				        ALL(permits_clean),
				        permits_clean[applied_date]
				    )
				RETURN
				ADDCOLUMNS(
				    CALENDAR(StartDate, EndDate),
				
				    "Year",
				        YEAR([Date]),
				
				    "Month Number",
				        MONTH([Date]),
				
				    "YearMonth",
				        FORMAT([Date], "yyyy-MM"),
				
				    "Month Start",
				        DATE(YEAR([Date]), MONTH([Date]), 1),
				
				    "Season",
				        SWITCH(
				            TRUE(),
				            MONTH([Date]) IN {12, 1, 2}, "Winter",
				            MONTH([Date]) IN {3, 4, 5}, "Spring",
				            MONTH([Date]) IN {6, 7, 8}, "Summer",
				            "Fall"
				        ),
				
				    "Policy Period",
				        SWITCH(
				            TRUE(),
				            [Date] < DATE(2024, 8, 6), "Before",
				            [Date] < DATE(2026, 8, 4), "During",
				            "After"
				        )
				)

	annotation PBI_Id = 62535aac04d045b1b054dafa329235ff

