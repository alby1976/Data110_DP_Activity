# Sample local environment file for the Calgary Development Permit Activity project.
#
# Copy this file to `.env` for local use. Do not commit `.env`, because it may
# contain credentials or machine-specific values.
#
# The active settings file points to this variable through:
#   data_source.app_token_env: "SOCRATA_APP_TOKEN"
#
# Socrata app tokens are optional for the public Calgary dataset. Leave the value
# blank to use anonymous access, or paste a token after the equals sign for higher
# API rate limits.

SOCRATA_APP_TOKEN=
